$TTL    604800
@       IN      SOA      ns.uwu.          root.uwu. (
                              4         ; Serial
                         604800         ; Refresh
                          86400         ; Retry
                        2419200         ; Expire
                         604800         ; default TTL
                    )
;

@              IN       NS      ns.uwu.
4              IN       PTR     ns.uwu
3              IN       PTR     supersite.uwu
5              IN       PTR     mumble.uwu
